# Backend environment variables
# Copy this file to .env for local development:
# cp backend/.env.example backend/.env
#
# Do not share your real .env. Each developer should use their own JWT_SECRET
# and their own SMTP/Mailtrap credentials.

NODE_ENV=development
PORT=3000

# When running inside the Dev Container/Docker network, use host "postgres".
# If running backend directly on the host machine, use:
# DATABASE_URL=postgres://portal_user:portal_pass@localhost:5433/portalweb
DATABASE_URL=postgres://portal_user:portal_pass@postgres:5432/portalweb

CORS_ORIGIN=http://localhost:5173
PUBLIC_SITE_URL=http://localhost:5173

# Local example only. Replace with a strong secret in any shared/staging/prod env.
JWT_SECRET=change_me_use_at_least_32_chars_here
JWT_EXPIRES_IN=8h
JWT_ADMIN_EXPIRES_IN=8h

# Optional seed users for local validation.
# Change these values before sharing a populated database.
INITIAL_ADMIN_NAME=Admin Sistema
INITIAL_ADMIN_EMAIL=admin@anjosdamadrugada.org.br
INITIAL_ADMIN_PASSWORD=change_me_123

TEST_VOLUNTEER_NAME=Voluntario Teste
TEST_VOLUNTEER_EMAIL=voluntario@anjosdamadrugada.org.br
TEST_VOLUNTEER_PASSWORD=change_me_123
TEST_VOLUNTEER_PHONE=51999999999

UPLOAD_DIR=/workspace/uploads
MAX_UPLOAD_MB=10

# SMTP / Mailtrap
# To validate forgot-password, invite and notification e-mails locally,
# create your own Mailtrap Sandbox inbox and fill these values in backend/.env.
# Example for Mailtrap Sandbox:
# SMTP_HOST=sandbox.smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_USER=your_mailtrap_user
# SMTP_PASS=your_mailtrap_password
# SMTP_FROM=Portal Anjos <no-reply@anjosdamadrugada.org.br>
# SMTP_SECURE=false
SMTP_HOST=
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Portal Anjos <no-reply@anjosdamadrugada.org.br>
SMTP_SECURE=false

EMAIL_QUEUE_INTERVAL_MS=60000
EMAIL_QUEUE_BATCH_SIZE=10
EMAIL_QUEUE_MAX_ATTEMPTS=3
EMAIL_QUEUE_SEND_DELAY_MS=1500
